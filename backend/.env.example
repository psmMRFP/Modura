# Copy values into your process environment; this file is not loaded automatically.
MODURA_DATABASE_URL=postgres://modura:replace-me@127.0.0.1:5432/modura?sslmode=disable
MODURA_AUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes
MODURA_AUTH_SIGNING_KEY_ID=primary
MODURA_AUTH_ISSUER=modura
MODURA_AUTH_AUDIENCE=modura-admin
MODURA_PLATFORM_AUTH_AUDIENCE=modura-platform
MODURA_AUTH_ACCESS_LIFETIME=5m
MODURA_AUTH_REFRESH_LIFETIME=24h
MODURA_AUTH_INVITATION_LIFETIME=24h
# Set false only for local HTTP development. Production cookies require TLS.
MODURA_AUTH_COOKIE_SECURE=true
# Create a missing application database through template1. Requires CREATEDB
# on the dedicated role only when missing; never use the postgres role/database.
# Set false after provisioning if automatic creation is not needed.
MODURA_DATABASE_AUTO_CREATE=true
