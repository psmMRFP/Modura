# Copy values into your process environment; this file is not loaded automatically.
WHERETOLIVE_DATABASE_URL=postgres://wheretolive:replace-me@127.0.0.1:5432/wheretolive?sslmode=disable
WHERETOLIVE_AUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes
WHERETOLIVE_AUTH_SIGNING_KEY_ID=primary
WHERETOLIVE_AUTH_ISSUER=wheretolive
WHERETOLIVE_AUTH_AUDIENCE=wheretolive-admin
WHERETOLIVE_PLATFORM_AUTH_AUDIENCE=wheretolive-platform
WHERETOLIVE_AUTH_ACCESS_LIFETIME=5m
WHERETOLIVE_AUTH_REFRESH_LIFETIME=24h
WHERETOLIVE_AUTH_INVITATION_LIFETIME=24h
# Set false only for local HTTP development. Production cookies require TLS.
WHERETOLIVE_AUTH_COOKIE_SECURE=true
# Create a missing application database through template1. Requires CREATEDB
# on the dedicated role only when missing; never use the postgres role/database.
# Set false after provisioning if automatic creation is not needed.
WHERETOLIVE_DATABASE_AUTO_CREATE=true

# Public consumer accounts stay disabled until delivery and abuse controls are configured.
WHERETOLIVE_PUBLIC_IDENTITY_ENABLED=false
# Required only when enabled: base64 encoding of an independent 32-byte key.
# Keep the key stable while mail is queued; rotate only after draining/expiring payloads.
WHERETOLIVE_IDENTITY_MAIL_KEY=
# Implicit TLS SMTP (typically port 465); no plaintext transport or certificate bypass.
WHERETOLIVE_SMTP_ADDRESS=
WHERETOLIVE_SMTP_USERNAME=
WHERETOLIVE_SMTP_PASSWORD=
WHERETOLIVE_SMTP_FROM=
WHERETOLIVE_PUBLIC_ORIGIN=
WHERETOLIVE_TURNSTILE_SECRET=
WHERETOLIVE_TURNSTILE_SITE_KEY=
WHERETOLIVE_TURNSTILE_HOSTNAME=
WHERETOLIVE_PUBLIC_VERIFY_LIFETIME=1h
WHERETOLIVE_PUBLIC_RESET_LIFETIME=15m
WHERETOLIVE_PUBLIC_RATE_WINDOW=1h
WHERETOLIVE_PUBLIC_GLOBAL_LIMIT=1000
WHERETOLIVE_PUBLIC_NETWORK_LIMIT=30
WHERETOLIVE_PUBLIC_ACCOUNT_LIMIT=10
